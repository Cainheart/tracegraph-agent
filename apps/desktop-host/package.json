{
  "name": "@tracegraph/desktop-host",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:e2e": "pnpm run build && vitest run src/desktop-host.e2e.test.ts",
    "test:unit": "vitest run src --exclude src/desktop-host.e2e.test.ts"
  },
  "dependencies": {
    "@tracegraph/api": "workspace:*",
    "@tracegraph/contracts": "workspace:*",
    "@tracegraph/core": "workspace:*",
    "@tracegraph/host": "workspace:*",
    "@tracegraph/sdk": "workspace:*",
    "@tracegraph/session": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tracegraph/test-support": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
