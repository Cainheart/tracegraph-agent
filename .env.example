# Copy this file to .env.local. Never commit the real key.
# Optional paths (the defaults are <repository>/.tracegraph and <repository>/.env.local):
# TRACEGRAPH_DATA_DIR=/absolute/path/to/private-data
# TRACEGRAPH_ENV_FILE=/absolute/path/to/.env.local
# G-17 data-only extension selection. Default: <TRACEGRAPH_DATA_DIR>/extensions.json.
# The strict JSON may select only extension ids installed in the Host-owned
# trusted catalog; it is never evaluated as JavaScript/TypeScript and its
# `module` values are catalog keys, not filesystem paths or npm specifiers.
# TRACEGRAPH_EXTENSION_CONFIG=/absolute/path/to/extensions.json
# Host-owned G-06 permission ceiling. Default: workspace-write.
# Values bind sandbox + approval policy as one preset:
#   read-only      = read-only sandbox + no write approval path
#   workspace-write = workspace sandbox + one-time approval for writes
#   full-write     = danger-full-access + no write prompt/request/grant/token
# The Web UI may only choose a preset at or below this ceiling; changes affect
# new Runs only. A project .tracegraph/policy.json may further ask/deny, never allow.
# TRACEGRAPH_PERMISSION_PRESET=workspace-write
# Legacy compatibility only. Do not set this together with a conflicting
# TRACEGRAPH_PERMISSION_PRESET; startup fails closed on a mismatch.
# TRACEGRAPH_SANDBOX_MODE=workspace-write
# Restricted run_test execution requires working macOS Seatbelt. Linux/Windows
# report the unmet boundary and refuse to start run_test; full-write is an explicit
# opt-out from child OS isolation, not a bypass of Workspace capability,
# canonical action/policy digest, hash validation, or WAL.
# Deterministic model/tool orchestration guard (not a token limit). Default: 12.
# TRACEGRAPH_MAX_TURNS=12
# Explicit single-target Action rollback is disabled by default.
# TRACEGRAPH_ROLLBACK_ENABLED=true
# Managed/read-write linked workspaces additionally require both this policy
# and force=true on the rollback request. Force never bypasses after-hash checks.
# TRACEGRAPH_ROLLBACK_ALLOW_FORCE=true

# G-15 telemetry is noop by default and never exports solely because this
# variable exists. To enable OTLP/HTTP, create <TRACEGRAPH_DATA_DIR>/telemetry.json
# with {"sink":"otlp_http"}; the standard endpoint variable is then resolved
# at Host startup. Put authorization in the G-19 credential store and reference
# it from telemetry.json as "authorization_ref":"${secret:NAME}".
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.test

# Generic TraceGraph configuration (works with any supported provider):
TRACEGRAPH_MODEL_PROVIDER=deepseek
TRACEGRAPH_MODEL_PROTOCOL=openai-chat-completions
TRACEGRAPH_MODEL_BASE_URL=https://api.deepseek.com
# Default preset: deepseek-v4-flash. Use deepseek-v4-pro when the account and
# task require the larger model.
TRACEGRAPH_MODEL=deepseek-v4-flash
TRACEGRAPH_MODEL_API_KEY=
# G-18 image blocks are opt-in and Host-owned. Default: false. Only true/false
# and 1/0 are accepted. This does not auto-detect provider/model support; enable
# it only for a configured model that is known to accept image input.
# TRACEGRAPH_MODEL_IMAGE_INPUT=false

# Alternatively, one provider-specific key is enough to use its defaults:
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GLM_API_KEY=
# QWEN_API_KEY=
# MINIMAX_API_KEY=
